# Copy to .env — never commit real secrets.

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# docker compose Postgres (host port 5433)
DATABASE_URL=postgresql://jobprep:jobprep@localhost:5433/jobprep?schema=public
TEST_DATABASE_URL=postgresql://jobprep:jobprep@localhost:5433/jobprep_test?schema=public

# Session / OTP
SESSION_SECRET=change-me-to-a-long-random-string
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Providers: fake | console in dev and tests. Real providers need merchant keys.
PAYMENT_PROVIDER_MODE=fake
SMS_PROVIDER=console
# Only honoured when NODE_ENV != production
ENABLE_TEST_ENDPOINTS=true

# Per-IP rate limits. Unset = on in production, off otherwise. Set true/false to force.
# RATE_LIMIT_ENABLED=false

# Where payment operators call back (webhooks). Must be https in production.
PUBLIC_API_URL=http://localhost:4000
# Signs the fake provider's webhooks in dev/tests (ignored in production)
FAKE_WEBHOOK_SECRET=fake-webhook-secret-dev-only

# pawaPay (mobile-money aggregator): the LIVE provider. When PAWAPAY_API_TOKEN is set it serves every payment method
# and the direct MTN / Airtel / M-Pesa adapters below are not used. Sandbox base URL: https://api.sandbox.pawapay.io
# Production REQUIRES the token and a callback secret of 16+ characters. Callback URL to set in the pawaPay dashboard:
#   <PUBLIC_API_URL>/api/payments/webhooks/pawapay?token=<PAWAPAY_CALLBACK_SECRET>
PAWAPAY_API_TOKEN=
PAWAPAY_BASE_URL=https://api.pawapay.io
PAWAPAY_CALLBACK_SECRET=

# Direct operator adapters (only used when PAWAPAY_API_TOKEN is empty; never run live) — MTN MoMo Collections (sandbox)
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENV=sandbox
MTN_MOMO_CALLBACK_SECRET=

# Airtel Money Collections (sandbox)
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_CALLBACK_SECRET=

# M-Pesa (Daraja sandbox) — Kenya
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_SECRET=

# Email (SMTP). Not used by the API yet; production values are in /opt/jobprep/.env
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_STARTTLS=true
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=JobPrep
